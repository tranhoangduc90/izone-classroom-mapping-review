      "constraints": [
        {
          "name": "term_test_attempt_completion_check",
          "type": "c",
          "definition": "CHECK ((((completed_at IS NULL) AND (reading_answers IS NULL) AND (reading_result IS NULL) AND (combined_result IS NULL)) OR ((completed_at IS NOT NULL) AND (reading_answers IS NOT NULL) AND (reading_result IS NOT NULL) AND (combined_result IS NOT NULL))))"
        },
        {
          "name": "term_test_attempt_exam_session_id_fkey",
          "type": "f",
          "definition": "FOREIGN KEY (exam_session_id) REFERENCES assessment.term_test_exam_session(id)"
        },
        {
          "name": "term_test_attempt_exam_session_id_key",
          "type": "u",
          "definition": "UNIQUE (exam_session_id)"
        },
        {
          "name": "term_test_attempt_pkey",
          "type": "p",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "term_test_attempt_section_deadline_check",
          "type": "c",
          "definition": "CHECK ((((reading_started_at IS NULL) AND (reading_deadline_at IS NULL)) OR ((reading_started_at IS NOT NULL) AND (reading_deadline_at > reading_started_at))))"
        },
        {
          "name": "term_test_attempt_test_slug_client_submission_id_key",
          "type": "u",
          "definition": "UNIQUE (test_slug, client_submission_id)"
        },
        {
          "name": "term_test_attempt_test_slug_fkey",
          "type": "f",
          "definition": "FOREIGN KEY (test_slug) REFERENCES assessment.test_definition(slug)"
        },
        {
          "name": "term_test_attempt_writing_draft_revision_check",
          "type": "c",
          "definition": "CHECK ((writing_draft_revision >= 0))"
        },
        {
          "name": "term_test_attempt_writing_order_check",
          "type": "c",
          "definition": "CHECK ((((writing_started_at IS NULL) AND (writing_updated_at IS NULL) AND (writing_submitted_at IS NULL)) OR ((completed_at IS NOT NULL) AND (writing_started_at IS NOT NULL) AND (writing_updated_at IS NOT NULL) AND ((writing_submitted_at IS NULL) OR (writing_submitted_at >= writing_started_at)))))"
        }
      ],
      "triggers": [
        {
          "name": "collaboration_row_history",
          "definition": "CREATE TRIGGER collaboration_row_history AFTER INSERT OR DELETE OR UPDATE ON assessment.term_test_attempt FOR EACH ROW EXECUTE FUNCTION collaboration.record_row()"
        },
        {
