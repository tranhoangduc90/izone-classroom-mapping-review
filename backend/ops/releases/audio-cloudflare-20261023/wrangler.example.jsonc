{
  "name": "izone-audio-delivery",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "r2_buckets": [{"binding": "AUDIO", "bucket_name": "izone-audio-r2-lab-20261023"}],
  "vars": {
    "AUDIO_ENABLED": "false",
    "AUDIO_ORIGINS": "[\"https://tranhoangduc90.github.io\"]"
  },
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
