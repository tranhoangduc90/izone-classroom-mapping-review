# Backend nhận cấu hình từ biến môi trường; không đưa giá trị thật vào repo.
NODE_ENV=production
PORT=8788
DATABASE_URL=postgresql://mapping_review_api:REPLACE_ME@mapping-postgres:5432/mapping_db
DB_POOL_MAX=10
LEARNING_ENABLED=false
LEARNING_DATABASE_URL=
LEARNING_DB_POOL_MAX=20
AUTH_MODE=google
GOOGLE_CLIENT_ID=REPLACE_WITH_PUBLIC_GOOGLE_CLIENT_ID
LEGACY_REVIEW_TOKEN=
ALLOWED_ORIGINS=https://tranhoangduc90.github.io
TEACHER_SESSION_IDLE_DAYS=90
TEACHER_SESSION_ABSOLUTE_DAYS=365
TEACHER_SESSION_COOKIE_NAME=izone_teacher_session
TEACHER_SESSION_COOKIE_PATH=/mapping-api
TEACHER_SESSION_COOKIE_SECURE=true
TEACHER_SESSION_COOKIE_PARTITIONED=true
TEACHER_SESSION_COOKIE_SAME_SITE=none
TRUST_PROXY_HOPS=1
ERP_SYNC_URL=https://n8n.example.invalid/webhook/dong-bo-diem-term-test
ERP_SYNC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ERP_SYNC_TIMEOUT_MS=5000
MINI_TEST_SYNC_SECRET=replace-with-at-least-32-random-characters
WRITING_TEST_SYNC_SECRET=replace-with-a-different-32-character-random-secret
TERM_TEST_PUBLIC_API_BASE_URL=https://example.invalid/mapping-api
TERM_TEST_ASSET_DIR=/app/private-assets
TERM_TEST_SESSION_SECRET=replace-with-a-different-32-character-random-secret
APP_VERSION=1.1.0
BUILD_SHA=unknown
